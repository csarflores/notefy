# MongoDB connection string
MONGODB_URI="mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/tu_db?retryWrites=true&w=majority"

# NextAuth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=genera-un-secreto-aleatorio-aqui

# Email (Gmail - para recuperación de contraseña)
# Genera una contraseña de aplicación en https://myaccount.google.com/apppasswords
EMAIL_USER="tu-email@gmail.com"
EMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# AWS S3 + CloudFront (subida de imágenes y adjuntos)
AWS_REGION="sa-east-1"
AWS_ACCESS_KEY_ID="tu-access-key-id"
AWS_SECRET_ACCESS_KEY="tu-secret-access-key"
AWS_S3_BUCKET="tu-bucket"
AWS_S3_PREFIX="notefy"
NEXT_PUBLIC_CLOUDFRONT_URL="https://xxxxxxxxxxxx.cloudfront.net"
